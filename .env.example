# Copy to .env.local. `npx supabase status` prints the local values.

# Public: safe to expose to the browser (access is enforced by row-level security).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row-level security; used only by the daily job and account deletion.
SUPABASE_SECRET_KEY=

# Server-only. Vercel Cron sends it as a Bearer token to /api/cron/daily.
CRON_SECRET=

# Recommended, free. The default AI: Google's Gemini Developer API. Create a key at
# https://aistudio.google.com/apikey. Server only: never give it a NEXT_PUBLIC_ name.
# Used for connection-note rewrites; in Discover, understanding requests, reading public pages
# and explaining matches; in Jobs, tailoring, cover letters, AI Improvement Notes and AI resume
# reading. Without it, every feature uses its non-AI path. On Gemini's free tier, Google may use
# what is sent (resume text, postings) to improve its products.
GEMINI_API_KEY=
# Optional. The Gemini model (default gemini-3.8-flash).
GEMINI_MODEL=

# Optional, not required. Use Anthropic Claude instead, only when GEMINI_API_KEY isn't set.
ANTHROPIC_API_KEY=

# Optional. Discover's public web search. Tavily's free plan (https://tavily.com, 1,000 searches a
# month, no card) is the easiest; Brave works too but now needs a card (https://brave.com/search/api/).
# Without either, Discover searches GitHub and ORCID only (free, no keys). LinkedIn is always excluded.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Recommended. A free GitHub token (Settings → Developer settings → Personal access tokens, no
# scopes needed). Without it GitHub allows only 60 profile lookups an hour, so searches run dry fast.
GITHUB_TOKEN=

# Jobs needs no API keys: postings come from employers' public job boards, Jobicy's public
# jobs API, and Remotive's and Arbeitnow's public feeds, all free.
# Optional, not required. Adzuna's job search API; with both set, Jobs also searches Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional, free. USAJOBS (U.S. federal jobs): request a key at https://developer.usajobs.gov/apirequest/
# and set the same email you requested it with. Used for searches in the United States only.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Recommended, free. Careerjet job search (90+ countries): create a publisher account at
# https://www.careerjet.com/partners/ and paste its API key here. Used from the Jobs page only.
CAREERJET_API_KEY=

# Optional, recommended. Turns on matching by meaning (Supabase's free gte-small model in
# the `embed` Edge Function). Any random string of 16+ characters; set the same value as an
# Edge Function secret (`supabase secrets set EMBED_SECRET=...`, or supabase/functions/.env locally).
EMBED_SECRET=

# Optional. Lets users store their own AI key (Gemini, or Anthropic) for AI rewording (encrypted with this).
# A random string of 32+ characters, e.g. from `openssl rand -hex 32`. Never change it once
# keys are stored, or they can't be read.
APP_ENCRYPTION_KEY=

# Optional. AI uses (tailoring, Improvement Notes, AI resume reading) per user per day on the server's
# AI key (unset = no limit; 0 = only users' own keys). Without AI, Tailor Resume gives Improvement Notes instead.
AI_DAILY_QUOTA=

# Optional. Email digests for saved-search alerts, over any SMTP server. Off unless all of
# SMTP_HOST, SMTP_FROM, APP_URL and EMAIL_TOKEN_SECRET are set, and each user opts in.
# In-app notifications work without any of this. Locally, Mailpit listens on port 54325
# (enable smtp_port in supabase/config.toml) and needs no user or password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The sender, e.g. "Network Growth <alerts@your-domain.example>". Use a domain you've verified with your provider.
SMTP_FROM=
# Your app's address, for links in emails, e.g. https://your-app.vercel.app
APP_URL=
# A random string of 32+ characters for unsubscribe links, e.g. from `openssl rand -hex 32`.
EMAIL_TOKEN_SECRET=

# Tests only: run Discover against a built-in fictional dataset (no network, no keys).
# DISCOVERY_FIXTURES=1
# Tests only: Jobs reads fictional employer boards and a fictional Jobicy feed, and uses a stand-in
# embedder and canned AI answers. Ignored in production builds (NODE_ENV=production) and on Vercel production.
# JOBS_FIXTURES=1

# Optional. Shows a "Send feedback" button in the navigation. A mailto: link
# (mailto:you@example.com?subject=Network%20Growth%20feedback) or a form link (Google Forms, Tally).
# Public by design; it is read at build time, so redeploy after changing it.
NEXT_PUBLIC_FEEDBACK_URL=

# Optional. A contact address shown in the Privacy Policy and Terms (/privacy, /terms). Public.
# Set it before launch: British Columbia's PIPA expects a reachable privacy contact. Without it,
# those pages point to the in-app feedback button.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional. Your name or business name, shown as the operator in those pages.
NEXT_PUBLIC_OPERATOR_NAME=

# Optional. The database plan's size in MB for the daily storage check (default 500, the free plan).
# DB_LIMIT_MB=500
# Optional. The id of the account that should get a bell notification when the database passes 70% of its limit
# (find it in Supabase Auth). Without it the warning is only written to the logs.
# OPERATOR_USER_ID=
