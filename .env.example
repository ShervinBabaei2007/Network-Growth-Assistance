# Copy to .env.local. `npx supabase status` prints the local values.

# Public: safe to expose to the browser (access is enforced by row-level security).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row-level security; used only by the daily job.
SUPABASE_SECRET_KEY=

# Server-only. Vercel Cron sends it as a Bearer token to /api/cron/daily.
CRON_SECRET=

# Optional. Enables Claude rewrites of connection-note drafts (Phase 6).
ANTHROPIC_API_KEY=
