# Copy to supabase/.env (git-ignored) to turn on "Continue with Google" for local development, then run:
#   npx supabase stop && npm run db:start
# Create the client in Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
